{
  "name": "@yieldbridge/indexer",
  "version": "0.1.0",
  "description": "Enterprise-grade on-chain event indexer, REST API, and zero-trust cryptographic engine for YieldBridge Core",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api.js",
    "indexer:start": "node dist/indexer.js",
    "dev:api": "tsx watch src/api.ts",
    "dev:indexer": "tsx watch src/indexer.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run"
  },
  "keywords": [
    "stellar",
    "soroban",
    "indexer",
    "yieldbridge",
    "cryptography",
    "prisma",
    "stormsale"
  ],
  "author": "YieldBridge Labs",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@stellar/stellar-sdk": "^12.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
